# The Odds API — get a free key at https://the-odds-api.com/
# Free tier: 500 requests/month. App falls back to mock data if not set.
ODDS_API_KEY=

# PostgreSQL connection string (Neon, Supabase, local, etc.)
DATABASE_URL=postgresql://user:password@host:5432/mvp

# Server port (default: 5000)
PORT=5000
